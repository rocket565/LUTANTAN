# ========== 通义万相 API 配置 ==========
# 阿里云通义万相 API Key
# 获取地址: https://dashscope.console.aliyun.com/
TONGYI_API_KEY=your_tongyi_api_key_here

# ========== OpenAI API 配置==========
# OpenAI API Key (用于脚本生成，可选)
# 如果不配置，将使用默认模拟脚本
# 获取地址: https://platform.openai.com/api-keys
# DeepSeek API 也可使用此配置（兼容 OpenAI 格式）
OPENAI_API_KEY=your_openai_or_deepseek_api_key_here

# OpenAI API Base URL（默认 OpenAI，DeepSeek 使用 https://api.deepseek.com）
OPENAI_API_BASE=https://api.deepseek.com

# 模型选择
# OpenAI: gpt-4o / gpt-4 / gpt-3.5-turbo
# DeepSeek: deepseek-chat / deepseek-coder
OPENAI_MODEL=deepseek-chat

# ========== 其他配置 ==========
# TTS 语音选择
# 男声: zh-CN-YunxiNeural, zh-CN-YunjianNeural
# 女声: zh-CN-XiaoxiaoNeural, zh-CN-XiaoyiNeural
TTS_VOICE=zh-CN-YunxiNeural

# 视频参数
VIDEO_FPS=24
VIDEO_HEIGHT=1080
VIDEO_CODEC=libx264
AUDIO_CODEC=aac

# 文件路径（通常不需要修改）
ASSETS_DIR=assets
